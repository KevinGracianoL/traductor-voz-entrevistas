[Unit]
Description=Traductor demo teleprompter
After=network.target

[Service]
User=kevin
WorkingDirectory=/home/kevin/traductor-voz-entrevistas
ExecStart=/home/kevin/traductor-voz-entrevistas/venv/bin/uvicorn src.traductor.ui.app:app --host 127.0.0.1 --port 8000
Restart=always
Environment=PYTHONPATH=src

[Install]
WantedBy=multi-user.target
